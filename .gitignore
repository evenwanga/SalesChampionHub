# ============================================
# SalesChampionHub 项目 .gitignore
# ============================================

# ===== 敏感信息 =====
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
secrets/
credentials/

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm
.yarn/

# ===== Go =====
# 二进制文件
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# 编译产物
vendor/
*.out

# Go 工作区
go.work
go.work.sum

# ===== Docker =====
# Docker 卷数据
**/volumes/
**/postgres_data/
**/redis_data/
**/nginx_logs/

# Docker 构建缓存
.dockerignore
docker-compose.override.yml

# ===== 数据库 =====
*.db
*.sqlite
*.sqlite3
*.sql.gz
backups/*.sql
backups/*.dump

# ===== 日志文件 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 编辑器/IDE =====
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===== 操作系统 =====
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ===== 临时文件 =====
tmp/
temp/
*.tmp
*.bak
*.cache
.cache/

# ===== 测试和覆盖率 =====
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
test-results/
junit.xml

# ===== 构建产物 =====
dist/
build/
out/
.next/
.nuxt/

# ===== Swagger =====
# 注意: 不忽略 docs/swagger/，因为需要提交生成的文档

# ===== 项目特定 =====
# 各子项目的构建输出
projects/*/bin/
projects/*/dist/
projects/*/build/

# 备份文件
*.backup
*.old

# ===== Kong =====
infrastructure/kong/logs/

# ===== Prometheus & Grafana =====
infrastructure/monitoring/data/

# ===== 证书文件 =====
*.p12
*.pfx
*.p7b

# ===== 其他 =====
.env.backup
.terraform/
*.tfstate
*.tfstate.backup
