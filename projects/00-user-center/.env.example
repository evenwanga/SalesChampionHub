# 用户中心环境配置
# 复制此文件为 .env 并修改配置

# ==================== 数据库配置 ====================
DB_PASSWORD=ChangeMeInProduction123!
DB_HOST=postgres
DB_PORT=5432
DB_NAME=logto
DB_USER=postgres

# ==================== Redis配置 ====================
REDIS_PASSWORD=RedisPassword123!
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== Logto配置 ====================
# 开发环境
ENDPOINT=http://localhost:3001
ADMIN_ENDPOINT=http://localhost:3002

# 生产环境（取消注释并修改）
# ENDPOINT=https://auth.yourdomain.com
# ADMIN_ENDPOINT=https://auth-admin.yourdomain.com

# ==================== JWT配置 ====================
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-me-in-production-32-chars-min

# Token过期时间（秒）
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=604800

# ==================== 服务API密钥 ====================
# 用于服务间调用（子项目调用用户中心API）
# 生成方法: openssl rand -hex 32
SERVICE_API_KEY=your-service-api-key-change-me-in-production

# ==================== 邮件配置 ====================
# SMTP服务器配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SalesChampionHub

# 邮件功能开关
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=true

# ==================== 短信配置（可选）====================
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=销冠培养
SMS_TEMPLATE_CODE_VERIFICATION=SMS_123456789

# ==================== 社交登录（可选）====================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==================== 日志配置 ====================
LOG_LEVEL=info
# 可选值: error, warn, info, debug, trace

# 日志输出格式
LOG_FORMAT=json
# 可选值: json, pretty

# ==================== 安全配置 ====================
# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
# 生产环境: https://yourdomain.com

# 速率限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Session配置
SESSION_SECRET=your-session-secret-change-me
SESSION_MAX_AGE=3600000

# ==================== 租户配额默认值 ====================
DEFAULT_PLAN=free

# Free计划配额
FREE_MAX_USERS=10
FREE_MAX_APPLICATIONS=5
FREE_MAX_API_CALLS_PER_DAY=10000
FREE_MAX_STORAGE_GB=10

# Pro计划配额
PRO_MAX_USERS=100
PRO_MAX_APPLICATIONS=20
PRO_MAX_API_CALLS_PER_DAY=100000
PRO_MAX_STORAGE_GB=100

# Enterprise计划配额
ENTERPRISE_MAX_USERS=1000
ENTERPRISE_MAX_APPLICATIONS=100
ENTERPRISE_MAX_API_CALLS_PER_DAY=1000000
ENTERPRISE_MAX_STORAGE_GB=1000

# ==================== 功能开关 ====================
# MFA功能
MFA_ENABLED=true

# SSO功能
SSO_ENABLED=true

# 审计日志
AUDIT_LOG_ENABLED=true

# Webhook通知
WEBHOOK_ENABLED=false

# ==================== 监控配置 ====================
# Prometheus
METRICS_ENABLED=true
METRICS_PORT=9090

# Sentry错误追踪（可选）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==================== 其他配置 ====================
# 时区
TZ=Asia/Shanghai

# 语言
DEFAULT_LOCALE=zh-CN

# Node环境
NODE_ENV=development

# ==================== 生产环境额外配置 ====================
# 仅生产环境需要

# SSL证书路径
# SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# 数据库SSL
# DB_SSL=true

# Redis集群（如使用）
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379

# 对象存储（如使用S3存储头像等）
# S3_BUCKET=saleschampionhub-avatars
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Logto 账号密码
